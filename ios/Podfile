# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# realm の podspec は prepare_command にチェックアウトの絶対パス（この ios ディレクトリ）を
# 埋め込むため、そのままでは Podfile.lock の SPEC CHECKSUMS の realm の行がチェックアウトの
# 場所ごとに変わり、ワークツリーで必ず差分が出る。
# CocoaPods は :path で読んだ podspec を Pods/Local Podspecs/<name>.podspec.json に書き出し、
# その SHA1 をチェックサムにしている（cocoapods-core の Specification#checksum）。
# realm に限り、この ios ディレクトリの絶対パスを固定の文字列に置き換えてから SHA1 を取り、
# 場所に依存しない値にする。Podfile.lock と Pods/Manifest.lock の両方がこの値で書かれるため、
# ビルドフェーズの [CP] Check Pods Manifest.lock とは食い違わない。
# realm は提供終了済み（20.2.0 が最終版）で SPM 対応も来ないため、Realm を外すまでこれで凌ぐ。
podfile_dirs = [File.dirname(File.expand_path(__FILE__)), File.dirname(File.realpath(__FILE__))].uniq
Pod::Specification.prepend(Module.new do
  define_method(:checksum) do
    return super() unless root? && name == 'realm' && defined_in_file
    @checksum ||= begin
      require 'digest'
      json = File.read(defined_in_file)
      podfile_dirs.each { |dir| json = json.gsub(dir, '<ios>') }
      Digest::SHA1.hexdigest(json)
    end
  end
end)

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Firestore をソースからビルドすると abseil / gRPC / BoringSSL / leveldb の
  # C++ コンパイルに 10〜15 分かかり、CI のビルド時間の大半を占める。
  # invertase のプリコンパイル済みフレームワークに差し替えてソースビルドを回避する。
  # tag は FirebaseFirestore のバージョン (Podfile.lock: 11.10.0) と一致させること。
  pod 'FirebaseFirestore',
    :git => 'https://github.com/invertase/firestore-ios-sdk-frameworks.git',
    :tag => '11.10.0'
  # invertase の binary Firestore (11.10.0) は FirebaseSharedSwift を = 11.10.0 で
  # 厳密固定して要求する。他の Firebase pod の制約は ~> 11.0 と緩いため、そのままだと
  # FirebaseSharedSwift が 11.12.0 に浮いて競合する。Firestore と揃えて 11.10.0 に固定する。
  pod 'FirebaseSharedSwift', '11.10.0'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end
  end
end
